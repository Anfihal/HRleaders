# docker compose settings. Copy to .env and fill in; .env is never committed.
# Generate secrets with e.g. `openssl rand -hex 32`.

POSTGRES_DB=hr_platform
POSTGRES_USER=hr
POSTGRES_PASSWORD=

# At least 32 characters.
JWT_SECRET=
# Shared by the API and the ФСП mock.
FSP_API_TOKEN=
# Shared private NATS transport credential; broker has no published host port.
NATS_TOKEN=
# Password of every demo account created by `docker compose run --rm seed`.
SEED_DEMO_PASSWORD=

# The stack is served over plain HTTP on localhost; behind TLS keep the default (true).
AUTH_COOKIE_SECURE=false
FRONTEND_PORT=8080
LOG_LEVEL=INFO

# Recruiting provider keys: JSON name -> secret, supplied only by a server administrator.
# Settings stores a name/reference and returns only a masked configured indicator.
RECRUITER_SECRETS={}
# Photo input: 5 MiB decoded file, 16 megapixels; nginx allows base64 JSON overhead.
AVATAR_MAX_BYTES=5242880
AVATAR_MAX_PIXELS=16000000
UPLOAD_MAX_BODY_SIZE=8m
# Diagnostic metadata only; never transcript, source images or credentials.
RECRUITING_DEBUG=false
