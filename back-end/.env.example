# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://hr:change-me@localhost:5432/hr_platform
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
# Set to false only for local HTTP development.
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=
LOG_LEVEL=INFO

FSP_API_URL=http://localhost:8001
FSP_API_TOKEN=replace-with-fsp-api-token
FSP_TIMEOUT_SECONDS=5

# Password of every demo account created by `python -m app.seed`.
SEED_DEMO_PASSWORD=

# Recruiting provider keys: JSON name -> secret, supplied only by a server administrator.
# Settings stores a name/reference and returns only a masked configured indicator.
RECRUITER_SECRETS={}
# Photo input: 5 MiB decoded file, 16 megapixels; nginx allows base64 JSON overhead.
AVATAR_MAX_BYTES=5242880
AVATAR_MAX_PIXELS=16000000

# API and worker must share this private object-storage directory.
MEDIA_STORAGE_PATH=.media
# Empty URL uses durable SQL polling for local development.
# To use JetStream: start `nats-server -js`, then set NATS_URL=nats://localhost:4222.
NATS_URL=
NATS_TOKEN=
WORKER_POLL_SECONDS=0.5
JOB_LEASE_SECONDS=180
JOB_RETRY_SECONDS=2
RECRUITING_DEBUG=false
